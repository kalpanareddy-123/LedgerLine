# ==============================================================================
# LedgerLine Environment Variables Configuration (.env.example)
# Copy this file to .env and fill in real values. Never commit .env with secrets.
# ==============================================================================

# Database Connection
DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
DB_USER=ledgerline_app
DB_PASSWORD=your_secure_database_password_here

# JWT Authentication Configuration
# Must be at least 256 bits (32 bytes) secret key for HMAC-SHA256
JWT_SECRET=ledgerline_super_secure_jwt_secret_key_minimum_256_bits_length_123456
JWT_EXPIRATION_MS=86400000

# Backend Server Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (for Vite frontend .env)
VITE_API_BASE_URL=http://localhost:8080/api

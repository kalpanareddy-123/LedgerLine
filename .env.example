# ==============================================================================
# LedgerLine Environment Variables Configuration (.env.example)
# Copy this file to .env and fill in real values. Never commit .env with secrets.
# ==============================================================================

# Database Connection
DB_URL=jdbc:postgresql://localhost:5432/ledgerline_db
DB_USER=ledgerline_app
DB_PASSWORD=your_secure_database_password_here

# JWT Authentication Configuration (minimum 256 bits / 32 bytes)
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=your_32_byte_random_jwt_secret_base64_here
JWT_EXPIRATION_MINUTES=30

# Backend Server Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Data Seeder (true only if you want demo accounts seeded on startup)
DEMO_SEED=true

# Maximum transaction amount allowed per transaction (in paise: 100,00,000 paise = ₹1,00,000)
MAX_TRANSACTION_AMOUNT=10000000

# Frontend Configuration
VITE_API_URL=http://localhost:8080
